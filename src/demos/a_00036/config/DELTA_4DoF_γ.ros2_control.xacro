<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="DELTA_4DoF_γ_ros2_control"  params="name initial_positions_file plugin:=mock_components/GenericSystem">
        <xacro:property name="initial_positions" value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/>
        
        <ros2_control name="${name}" type="system">
            <hardware>
                <!-- By default, set up controllers for simulation. This won't work on real hardware -->
                <plugin>${plugin}</plugin>
            </hardware>
            <joint name="Chain1_1">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['Chain1_1']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="Chain2_1">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['Chain2_1']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="Chain3_1">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['Chain3_1']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="Chain4_1">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['Chain4_1']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>

        </ros2_control>
    </xacro:macro>
</robot>
